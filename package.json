{
  "name": "jsg-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build:landing": "vite build",
    "typecheck:landing": "tsc --noEmit",
    "test:landing": "node --test tools/landing-page-contract.test.mjs",
    "test:assets": "node tools/validate-assets.mjs",
